# Local only by default. Use 0.0.0.0 only on a trusted LAN.
PASADHI_HOST=127.0.0.1
PASADHI_PORT=8765
# Coordinator fetches these worker addresses. Each worker needs v0.1.3 or newer.
PASADHI_WORKERS=
# Optional stable URL displayed at startup. Configure the DNS record separately.
PASADHI_PUBLIC_URL=

# Optional mDNS: requires explicit --role coordinator and LAN binding.
PASADHI_MDNS=0
PASADHI_MDNS_NAME=pasadhi
# Optional NIC name, e.g. eth0 or Wi-Fi 2. Empty = active nonvirtual LAN interfaces.
PASADHI_MDNS_INTERFACE=
# Leave blank to advertise the real app port. Set 80 only after configuring a proxy.
PASADHI_MDNS_PORT=

# Discover other PASADHI instances on this LAN (requires zeroconf).
PASADHI_DISCOVERY=1
