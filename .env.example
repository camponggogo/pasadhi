# Local only by default. Use 0.0.0.0 only on a trusted LAN.
PASADHI_HOST=127.0.0.1
PASADHI_PORT=8765
# Coordinator fetches these worker addresses. Each worker needs v0.1.3 or newer.
PASADHI_WORKERS=
# Optional stable URL displayed at startup. Configure the DNS record separately.
PASADHI_PUBLIC_URL=
